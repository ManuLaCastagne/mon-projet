views:
  - type: table
    name: Tableau
    filters:
      and:
        - "!culture_g_score.isEmpty()"
        - file.folder == "Littérature"
    order:
      - file.name
      - file.folder
      - culture_g_score
      - culture_g_justification
    sort:
      - property: culture_g_score
        direction: DESC
    columnSize:
      file.name: 186
      note.culture_g_score: 49
  - type: table
    name: Vue
    filters:
      and:
        - "!culture_g_score.isEmpty()"
    order:
      - file.name
      - culture_g_score
      - file.backlinks
    sort:
      - property: culture_g_score
        direction: DESC
    columnSize:
      file.name: 253
      note.culture_g_score: 56
